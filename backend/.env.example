APP_NAME=Smart AI Resume Analyzer
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-in-production-use-openssl-rand

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_analyzer

# File storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_FILE_SIZE_MB=10

# AI
SPACY_MODEL=en_core_web_sm
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Optional: Anthropic for LLM suggestions
ANTHROPIC_API_KEY=
